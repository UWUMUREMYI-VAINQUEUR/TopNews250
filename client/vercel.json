{
  "rewrites": [
    {
      "source": "/post/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|ia_archiver|vkshare).*"
        }
      ],
      "destination": "https://topnews250.onrender.com/share/post/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}